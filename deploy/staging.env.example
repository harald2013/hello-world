# Inject these values separately into API, worker and schema job in Coolify.
# Replace credentials locally/in Coolify, never commit a rendered file.
APP_ENV=staging
DATABASE_URL=postgresql://reports:REPLACE_PASSWORD@report-postgres:5432/reports
TEMPORAL_ADDRESS=report-temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=reports-v1
TEMPORAL_TLS=false
API_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
