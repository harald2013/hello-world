# Inject through the hosting provider's secret settings, not into the image.
APP_ENV=production
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_NEON_HOST/reports?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
TEMPORAL_ADDRESS=REPLACE_NAMESPACE.REGION.api.temporal.io:7233
TEMPORAL_NAMESPACE=REPLACE_NAMESPACE
TEMPORAL_TASK_QUEUE=reports-v1
TEMPORAL_TLS=true
TEMPORAL_API_KEY=REPLACE_WITH_NAMESPACE_SCOPED_KEY
API_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
